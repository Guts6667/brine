{
  "name": "brine",
  "version": "2.0.1",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:workflow-build": "node scripts/verify-workflow-build.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "better-sqlite3": "13.0.3",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "parse5": "^8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "workflow": "^5.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "^7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@workflow/core": {
      "devalue": "5.9.3",
      "nanoid": "5.1.16"
    }
  }
